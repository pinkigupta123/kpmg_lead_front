# For Android Emulator: Use http://10.0.2.2:8000/api
# For Physical Phone (Expo Go): Use your computer's local network IP (e.g. http://192.168.1.15:8000/api)

# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api
